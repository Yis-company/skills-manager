{
  "name": "skills-manager",
  "version": "1.46.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "cli": "node scripts/run-rust-cli.mjs cli",
    "cli:build": "node scripts/run-rust-cli.mjs build",
    "cli:install": "node scripts/run-rust-cli.mjs install",
    "test": "vitest run",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-version.mjs",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
